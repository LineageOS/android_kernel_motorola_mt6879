# add for svp
CONFIG_MOTO_BYPSS_RF_CABLE_DETECT=y

CONFIG_DRM_PANEL_TIANMA_NT37701A_655_FHDP_DPHY_CMD_144HZ=m
CONFIG_DRM_PANEL_TIANMA_NT37701A_655_FHDP_DPHY_CMD_144HZ_RODE=m

CONFIG_MTK_VIDEO_AW36515=m
CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_dubai_ov50a_mipi_raw mot_dubai_ov32c_mipi_raw mot_dubai_gc02m1b_mipi_raw mot_dubai_hi1336_mipi_raw"

# Add swtp customization
CONFIG_MOTO_TESLA_SWTP_CUST=y

# Moto Tesla Camera eeprom
CONFIG_MTK_EEPROM_PROJECT="tesla"

# SAR
CONFIG_AW86715=m

# NFC
CONFIG_NFC_PN557=m
