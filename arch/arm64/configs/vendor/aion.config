CONFIG_MOTO_BYPSS_RF_CABLE_DETECT_SUPPORT=y
# Enable MKP test on debug builds.
CONFIG_MTK_MKP_TEST=m

#add light_1
CONFIG_MOTO_LIGHT_1_SENSOR=y
# CONFIG_MTK_VIDEO_LM3643 is not set

CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_aion_ov50a_mipi_raw mot_aion_ov50e_mipi_raw mot_aion_s5kgd2_mipi_raw mot_aion_hi1336_mipi_raw"

# CONFIG_GAUGE_MT6375 is not set
# CONFIG_SCSI_UFS_HPB is not set
# CONFIG_UFSSHPB is not set

CONFIG_MOTO_PE50_CV_LOWER_BOUND_GAP_OFF=y

#Moto Aion Camera eeprom
CONFIG_MTK_EEPROM_PROJECT="aion"

# Charger
CONFIG_MOTO_SGM62110=m
CONFIG_CPS4038_MMI=m

# DRM
CONFIG_DRM_PANEL_CSOT_VTDR6115_655_FHDP_DPHY_VDO_144HZ=m
CONFIG_DRM_PANEL_TIANMA_VTDR6115_655_FHDP_DPHY_VDO_144HZ=m

# NFC
CONFIG_NFC_ST54NFC=m

# SAR
CONFIG_AW86715=m

# Add swtp customization
CONFIG_MOTO_AION_SWTP_CUST=y

# Enable moto sched
# CONFIG_SCHED_MOTO_UNFAIR is not set

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_V3=m
CONFIG_INPUT_FOCALTECH_V3_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_FTS_DOUBLE_TAP_CONTROL=y
CONFIG_FTS_SUPPORT_HIGH_RESOLUTION=y
CONFIG_FTS_LAST_TIME=y
CONFIG_FTS_COMPATIBLE_WITH_GKI=y
