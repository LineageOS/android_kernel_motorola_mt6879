# MTK
CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_manaus_ov50a_mipi_raw mot_manaus_ov32b_mipi_raw mot_manaus_hi1336_mipi_raw"

#Moto Manaus Camera eeprom
CONFIG_MTK_EEPROM_PROJECT="manaus"

# Moto
CONFIG_AW_MTK_RCV_SUPPORT=y
CONFIG_FSA4480_SENS_TO_GND=y

# DRM
# CONFIG_DRM_PANEL_CSOT_VTDR6115_655_FHDP_DPHY_VDO_144HZ is not set
CONFIG_DRM_PANEL_CSOT_VTDR6115_655_FHDP_DPHY_VDO_144HZ_C7=m
CONFIG_DRM_PANEL_TIANMA_VTDR6115_655_FHDP_DPHY_VDO_144HZ_U8=m
CONFIG_DRM_PANEL_BOE_NT37701A_655_FHDP_CMD_144HZ=m

# Fingerprint
CONFIG_INPUT_GOODIX_FOD_MMI=m

# NFC
CONFIG_NXP_NFC_I2C=m
CONFIG_NXP_ESE_P73=m

# Add swtp customization
CONFIG_MOTO_MANAUS_SWTP_CUST=y

# enable moto sched
# CONFIG_SCHED_MOTO_UNFAIR is not set

# Touchscreen
CONFIG_TOUCHCLASS_MMI_MULTIWAY_UPDATE_FW=y
